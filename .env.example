APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Hacienda (Costa Rica) ---
HACIENDA_ENV=stag
HACIENDA_VERIFY_SSL=true
# HACIENDA_TIMEOUT=60

# --- Compatibilidad con el API legacy ---
# El endpoint /api.php está apagado salvo que se active aquí.
LEGACY_API_ENABLED=false
LEGACY_OPEN_ENDPOINTS=true
# Clave AES-256-CBC del legacy (variable cryptoKey del .env viejo); solo se
# necesita para validar sesiones existentes y para legacy:migrate-data.
LEGACY_CRYPTO_KEY=

# --- BD del legacy (para php artisan legacy:migrate-data) ---
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=4407
LEGACY_DB_DATABASE=testdb
LEGACY_DB_USERNAME=testuser
LEGACY_DB_PASSWORD=testpassword

# --- API REST v1 ---
API_VERSION=1.0.0
# Documentación Swagger/OpenAPI en /docs/api. Poner false en producción.
SCRAMBLE_ENABLED=true
# Lista blanca CORS del REST (coma-separada). '*' permite cualquier origen.
CORS_ALLOWED_ORIGINS=*

# --- Telemetría anónima ---
# Una vez al día envía un UUID aleatorio de la instalación, API_VERSION y la
# versión de PHP, para contar instalaciones activas. Ningún dato de emisores
# ni comprobantes. `php artisan telemetry:status` muestra el envío exacto.
TELEMETRY_ENABLED=true
