# .env de PRODUCCIÓN del API Hacienda (docker-compose.prod.yml).
#   cp .env.production.example .env
# Lo leen Laravel (env_file) y docker compose (credenciales de la base).
# Guía: README § Producción.

# `docker compose ...` a secas usa el compose de producción.
COMPOSE_FILE=docker-compose.prod.yml

APP_NAME="API Hacienda"
APP_ENV=production
APP_DEBUG=false
# Se genera UNA sola vez y se respalda fuera del servidor: cifra las
# credenciales ATV guardadas (usuario, contraseña y PIN). Si se pierde o se
# cambia, hay que volver a cargarlas todas.
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://127.0.0.1:8888
# APP_TIMEZONE no se toca: el default (America/Costa_Rica) es el que usan
# las fechas de los comprobantes.

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

# --- Base de datos: servicio mysql (MariaDB) del compose, sin puerto publicado ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=api_hacienda
DB_USERNAME=hacienda
# Contraseñas propias y largas (openssl rand -hex 24). Solo se aplican al
# crear la base; en un servidor que ya tiene base, DB_PASSWORD debe ser la
# que ya usa (o cambiarse antes con ALTER USER).
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- REST v1 ---
# Documentación OpenAPI (/docs/api) apagada en producción.
SCRAMBLE_ENABLED=false
API_VERSION=1.0.0
# Orígenes de navegador permitidos, separados por coma. Vacío = ninguno
# (si solo lo consumen otros servidores, no hace falta CORS). Nunca '*'.
CORS_ALLOWED_ORIGINS=

# --- Hacienda (Costa Rica) ---
# El ambiente (stag/prod) viaja en cada request; no hay variable global.
HACIENDA_VERIFY_SSL=true
HACIENDA_TIMEOUT=60

# --- Compatibilidad con el API legacy (/api.php) ---
# El endpoint /api.php está apagado salvo que se active aquí.
LEGACY_API_ENABLED=false
# Clave AES-256-CBC del legacy (cryptoKey del .env viejo). Solo hace falta
# si hay sesiones legacy que validar o datos que migrar.
LEGACY_CRYPTO_KEY=

# --- Correo (sendMail del legacy y recuperación de contraseña) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Telemetría anónima ---
# Una vez al día envía un UUID aleatorio de la instalación, API_VERSION y la
# versión de PHP, para contar instalaciones activas. Ningún dato de emisores
# ni comprobantes. `php artisan telemetry:status` muestra el envío exacto.
TELEMETRY_ENABLED=true

# --- Endurecimiento del REST v1 ---
# Minutos de vida de los tokens Sanctum; vacío = no expiran.
SANCTUM_EXPIRATION=1440
# Registro abierto de cuentas master (POST /auth/register). Apagar una vez creada la cuenta.
AUTH_REGISTRATION_ENABLED=false
# Validar el XML firmado contra el XSD v4.4 antes de enviarlo a Hacienda (422 si no cumple).
HACIENDA_XSD_BEFORE_SEND=true
